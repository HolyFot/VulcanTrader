{
    "db_url": "json:user_data/accounts/trades-DriftTop50.json",
    "bot_name": "Drift Top50",
    "is_bot": false,
    "dry_run": true,
    "strategy": "",
    "auto_start": false,
    "show_terminal": false,
    "tmux": false,
    "initial_state": "running",
    "force_entry_enable": false,
    "hyperopt_ignore_missing_space": true,
    
    "$schema": "https://schema.freqtrade.io/schema.json",
