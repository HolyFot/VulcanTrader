        "use_order_book": false,
        "order_book_top": 1
    },
    "exchange": {
        "name": "drift",
        "key": "",
        "secret": "",
        "ccxt_async_config": {},
        "use_public_trades": false,
        "pair_whitelist": [],
        "pair_blacklist": [],
        "ccxt_config": {
            "enableRateLimit": true,
            "rateLimit": 50
        }
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 50,
            "sort_key": "quoteVolume",
            "min_value": 0,
            "refresh_period": 3600
        }
    ],
    "internals": {
